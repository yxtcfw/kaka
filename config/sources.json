    },
    {
      "name": "IT之家",
      "type": "json",
      "url": "https://api.ithome.com/json/newslist/news",
      "items_path": "newslist",
      "fields": { "title": "title", "url": "url", "summary": "description", "date": "postdate" },
      "weight": 0.7,
      "enabled": true
    },
    {
      "name": "36氪",
      "type": "rss",
      "url": "https://36kr.com/feed",
