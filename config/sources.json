    {
      "name": "知乎热榜",
      "type": "json",
      "url": "https://api.zhihu.com/topstory/hot-list?limit=50",
      "items_path": "data",
      "fields": { "title": "target.title", "url": "target.url", "summary": "target.excerpt" },
      "weight": 1.2,
      "enabled": false,
      "_note": "要 Referer 头、海外 IP 常 403，先关着，本地跑通了再打开"
    },
    {
      "name": "示例列表页",
