    "fetch-body": "node scripts/cli.js fetch-body",
    "collect": "node scripts/cli.js collect-sources",
    "write": "node scripts/cli.js write-content",
    "nav-pages": "node scripts/cli.js build-nav-pages",
    "fill-site": "node scripts/cli.js fill-site",
    "build": "node scripts/cli.js build",
    "pipeline": "node scripts/cli.js pipeline",
    "prune": "node scripts/cli.js prune",
    "drift-check": "node scripts/cli.js drift-check",
    "metrics": "node scripts/cli.js fetch-metrics",
