{
  "name": "vertical-site-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "v7 minimal-runnable automated vertical site template (zero runtime dependency)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "validate": "node scripts/cli.js validate",
    "bootstrap": "node scripts/cli.js bootstrap",
    "harvest": "node scripts/cli.js harvest",
    "grow-tree": "node scripts/cli.js grow-tree",
