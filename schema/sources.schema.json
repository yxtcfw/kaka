{
  "schema": "metaschema/v1",
  "type": "object",
  "required": ["schema", "sources"],
  "properties": {
    "schema": { "type": "string", "const": "sources/v1" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sourceId", "url", "domain", "grade", "status", "discoveredBy"],
        "properties": {
          "sourceId": { "type": "string" },
          "url": { "type": "string" },
          "domain": { "type": "string" },
          "title": { "type": "string" },
          "grade": { "type": "string", "enum": ["L1", "L2", "L3"] },
          "status": { "type": "string", "enum": ["candidate", "approved", "rejected"] },
          "bodyKind": { "type": "string", "enum": ["fulltext", "excerpt", "none"] },
          "bodyExcerpt": { "type": "string" },
          "discoveredBy": { "type": "string", "enum": ["seed", "search", "manual", "collect"] },
          "fetchedAt": { "type": "string" }
        }
      }
    }
  }
}
